@startuml ProductService
skinparam classAttributeIconSize 0
hide circle

class Product {
  - id : Long
  - name : String
  - price : double
  + Product()
  + Product(id : Long, name : String, price : double)
  + getId() : Long
  + getName() : String
  + getPrice() : double
  + setId(id : Long) : void
  + setName(name : String) : void
  + setPrice(price : double) : void
}

class ProductService <<Service>> {
  - products : List<Product>
  - nextId : Long
  + getAllProducts() : List<Product>
  + getProductById(id : Long) : Optional<Product>
  + addProduct(product : Product) : Product
  + deleteProduct(id : Long) : void
  + findByName(name : String) : List<Product>
  + findCheaperThan(price : double) : List<Product>
}

class ProductController <<RestController>> {
  - productService : ProductService
  + getAllProducts() : List<Product>
  + getProductById(id : Long) : Product
  + addProduct(product : Product) : Product
  + deleteProduct(id : Long) : void
  + search(name : String) : List<Product>
  + cheaperThan(price : double) : List<Product>
}

' ..> is a dependency: DASHED line, open arrow
ProductController ..> ProductService : uses

' --> is an association: SOLID line
ProductService --> "0..*" Product : holds

@enduml
